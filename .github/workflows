name: Build ICEDRAGONSTORE APK

on:
  workflow_dispatch:
  push:
    paths:
      - 'icedragonstore_games_supabase_update.zip'
      - '.github/workflows/build-apk.yml'

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 60

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check ZIP exists
        shell: bash
        run: |
          set -euo pipefail
          ZIP_FILE="icedragonstore_games_supabase_update.zip"

          test -f "$ZIP_FILE" || {
            echo "::error::ZIP tidak ditemui: $ZIP_FILE"
            echo "Pastikan fail ZIP berada di root repository."
            exit 1
          }

          echo "ZIP ditemui:"
          ls -lh "$ZIP_FILE"

      - name: Validate and extract project
        shell: bash
        run: |
          set -euo pipefail
          ZIP_FILE="icedragonstore_games_supabase_update.zip"

          unzip -tq "$ZIP_FILE"
          mkdir -p extracted
          unzip -q "$ZIP_FILE" -d extracted

          echo "Fail projek yang dijumpai:"
          find extracted -maxdepth 6 \
            \( -name pubspec.yaml -o -name gradle.properties -o -name local.properties -o -name gradlew \) \
            -print

      - name: Locate Flutter project
        shell: bash
        run: |
          set -euo pipefail

          PUBSPEC="$(find "$GITHUB_WORKSPACE/extracted" -type f -name pubspec.yaml -print -quit)"

          if [ -z "$PUBSPEC" ]; then
            echo "::error::pubspec.yaml tidak ditemui dalam ZIP"
            echo "Semak bahawa ZIP mengandungi projek Flutter, bukan hanya fail sumber terpilih."
            exit 1
          fi

          PROJECT_DIR="$(dirname "$PUBSPEC")"

          if [ ! -f "$PROJECT_DIR/android/gradlew" ]; then
            echo "::error::android/gradlew tidak ditemui dalam projek"
            exit 1
          fi

          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"
          echo "Projek Flutter: $PROJECT_DIR"

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Show build environment
        shell: bash
        run: |
          set -euo pipefail
          flutter --version
          java -version
          echo "ANDROID_HOME=${ANDROID_HOME:-not-set}"
          echo "ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-not-set}"
          ls -ld "${ANDROID_HOME:-/nonexistent}" || true

      - name: Repair Android SDK configuration
        working-directory: ${{ env.PROJECT_DIR }}
        shell: bash
        run: |
          set -euo pipefail

          SDK="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"

          if [ -z "$SDK" ] || [ ! -d "$SDK" ]; then
            echo "::error::Android SDK tidak ditemui pada runner"
            exit 1
          fi

          echo "Menggunakan Android SDK: $SDK"
          printf 'sdk.dir=%s\n' "$SDK" > android/local.properties

          while IFS= read -r -d '' file; do
            sed -i '/^[[:space:]]*android\.aapt2FromMavenOverride[[:space:]]*=/d' "$file"
          done < <(find . -type f -name gradle.properties -not -path './.git/*' -print0)

          echo "Semakan Android Build Tools:"
          ls -la "$SDK/build-tools" || true

          echo "Semakan AAPT2:"
          find "$SDK/build-tools" -maxdepth 2 -type f -name aapt2 -print || true

      - name: Get dependencies
        working-directory: ${{ env.PROJECT_DIR }}
        run: flutter pub get

      - name: Diagnose AAPT2 overrides
        working-directory: ${{ env.PROJECT_DIR }}
        shell: bash
        run: |
          set -euo pipefail
          echo "Memeriksa tetapan AAPT2 dan Android SDK..."
          grep -RIn --exclude-dir=.git --exclude-dir=.gradle 'aapt2FromMavenOverride\|/root/android-sdk' android . --include='*.properties' --include='*.gradle' --include='*.gradle.kts' || true

      - name: Build release APK
        working-directory: ${{ env.PROJECT_DIR }}
        run: flutter build apk --release

      - name: Verify APK
        working-directory: ${{ env.PROJECT_DIR }}
        shell: bash
        run: |
          set -euo pipefail
          APK_DIR="build/app/outputs/flutter-apk"

          if ! compgen -G "$APK_DIR/*.apk" > /dev/null; then
            echo "::error::APK tidak dijana"
            exit 1
          fi

          ls -lh "$APK_DIR"/*.apk

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: icedragonstore-release-apk
          path: ${{ env.PROJECT_DIR }}/build/app/outputs/flutter-apk/*.apk
          if-no-files-found: error
          retention-days: 7
